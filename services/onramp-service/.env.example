# BITBIT On-Ramp Service — Environment Variables
# GERÇEK API ANAHTARI KULLANMA — sadece sandbox/test modu

NODE_ENV=development
PORT=3001

# PostgreSQL
DATABASE_URL=postgresql://bitbit:bitbit@localhost:5432/bitbit

# Redis
REDIS_URL=redis://localhost:6379

# On-ramp sandbox provider
ONRAMP_SANDBOX_URL=https://sandbox.onramp-provider.com
ONRAMP_SANDBOX_KEY=sk_test_sandbox

# Off-ramp (status check için)
OFFRAMP_SANDBOX_URL=https://sandbox.offramp-provider.com
OFFRAMP_SANDBOX_KEY=sk_test_sandbox
